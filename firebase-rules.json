{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('status').val() === 'lobby') || (data.exists() && data.child('hostUid').val() === auth.uid))",
        "hostUid": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "status": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "createdAt": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "updatedAt": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "settings": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "players": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('rooms').child($roomId).child('players').child(auth.uid).exists())",
            ".write": "auth != null && $uid === auth.uid && ((!data.exists() && root.child('rooms').child($roomId).child('status').val() === 'lobby' && newData.child('team').val() === 'unassigned' && newData.child('role').val() === 'operative' && newData.child('isHost').val() === false) || (data.exists() && !newData.exists() && root.child('rooms').child($roomId).child('status').val() === 'lobby'))",
            "name": {
              ".write": "auth != null && $uid === auth.uid",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "online": {
              ".write": "auth != null && $uid === auth.uid && newData.isBoolean()"
            },
            "lastSeen": {
              ".write": "auth != null && $uid === auth.uid && (newData.isNumber() || newData.val() === null)"
            }
          }
        },
        "publicGame": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()"
        },
        "secret": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || root.child('rooms').child($roomId).child('players').child(auth.uid).child('role').val() === 'spymaster')"
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
          "$actionId": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('type').isString()"
          }
        },
        "actionResults": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$actionId": {
              ".write": "auth != null && auth.uid === $uid && !newData.exists()"
            }
          }
        }
      }
    }
  }
}
